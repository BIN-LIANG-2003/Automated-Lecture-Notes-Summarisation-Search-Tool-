# App mode
# Production auth guard is enabled only when APP_ENV=production or FLASK_ENV=production.
APP_ENV=development
# FLASK_ENV=development

# Database
# Leave DATABASE_URL empty to use local SQLite database.db.
# DATABASE_URL=postgresql://user:password@host:5432/studyhub

# Auth
# Required in production. Must be explicitly set in AUTH_TOKEN_SECRET,
# must be at least 32 characters long,
# and must not be empty or one of: changeme, change-me, default, secret, studyhub,
# or the built-in development fallback.
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800

# Legacy local-development fallback supported for older setups.
# It does not satisfy the production guard when APP_ENV=production or FLASK_ENV=production.
# FLASK_SECRET_KEY=

# App URLs and email
# APP_BASE_URL should be the public app origin that serves both the SPA and /api.
# It is used for invite links and account-verification links.
# APP_BASE_URL=http://127.0.0.1:5173
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=StudyHub <onboarding@resend.dev>
# EMAIL_VERIFICATION_TTL_HOURS=24

# Optional object storage. If unset, files are stored in local uploads/.
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# OCR and summarisation
# HF_API_TOKEN=
# HF_MODEL_BASE_URL=https://router.huggingface.co/hf-inference/models
# HF_OCR_MODEL=lbin2021/my-lecture-ocr
# HF_SUMMARIZER_MODEL=facebook/bart-large-cnn
# EXTERNAL_OCR_SERVICE_URL=
# EXTERNAL_OCR_TIMEOUT_SECONDS=60
# OCRMYPDF_BINARY=ocrmypdf
# OCRMYPDF_LANGUAGE=eng
# ENABLE_PDF_OCR_FALLBACK=1
# OCRMYPDF_TIMEOUT_SECONDS=180

# App behaviour
# TRASH_RETENTION_DAYS=30

# Transitional compatibility note:
# `/api/documents/:id/file?auth_token=...` is still accepted for inline preview only.
# It is temporary, returned with no-store caching, and should be migrated to header auth later.
