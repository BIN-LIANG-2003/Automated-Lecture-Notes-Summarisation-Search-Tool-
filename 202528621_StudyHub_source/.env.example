# App mode
# Explicit development mode allows a generated per-process auth secret when no strong
# AUTH_TOKEN_SECRET is configured. All other modes require a strong secret at startup.
APP_ENV=development
# FLASK_ENV=development

# Database
# Leave DATABASE_URL empty to use local SQLite database.db.
# DATABASE_URL=postgresql://user:password@host:5432/studyhub

# Auth
# Required outside APP_ENV=development / FLASK_ENV=development.
# Must be at least 32 characters long and must not be empty or a placeholder.
# In explicit development mode, leaving this empty generates a per-process random
# secret; existing local auth tokens will be invalid after each restart.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# Legacy local-development fallback supported for older setups.
# It is accepted for auth tokens only when it is at least 32 characters long.
# FLASK_SECRET_KEY=

# App URLs and email
# APP_BASE_URL should be the public app origin that serves both the SPA and /api.
# It is used for invite links and account-verification links.
# In production, APP_BASE_URL must be set explicitly; there is no production fallback domain.
# APP_BASE_URL=http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_ENABLED is enabled by default in production; set 1 locally only when testing the guard.
# RATE_LIMIT_ENABLED=0
# RATE_LIMIT_WINDOW_SECONDS=60
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=StudyHub <onboarding@resend.dev>
# EMAIL_VERIFICATION_TTL_HOURS=24

# Private in-app feedback
# SUPPORT_EMAIL receives new-feedback admin notifications and is shown in the feedback modal footer.
# FEEDBACK_ADMIN_USERNAMES is a comma-separated list of usernames allowed to open /#/admin/feedback.
# SUPPORT_EMAIL=hello@studies-hub.com
# FEEDBACK_ADMIN_USERNAMES=alice,teacher-admin

# Optional object storage. If unset, files are stored in local uploads/.
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# OCR and summarisation
# HF_API_TOKEN=
# HF_MODEL_BASE_URL=https://router.huggingface.co/hf-inference/models
# HF_OCR_MODEL=lbin2021/my-lecture-ocr
# HF_SUMMARIZER_MODEL=facebook/bart-large-cnn
# HF_SUMMARIZER_TIMEOUT_SECONDS=60
# SUMMARY_PRIMARY_STRATEGY=auto
# SUMMARY_FALLBACK_ENABLED=1
# SUMMARY_MIN_WORDS_FOR_BART=120
# SUMMARY_CHUNK_WORDS=650
# SUMMARY_CHUNK_OVERLAP=80
# TEXTRANK_SENTENCE_COUNT=3
# SUMMARY_TARGET_MAX_WORDS=140
# SUMMARY_GENERATION_LOCK_LEASE_SECONDS=900
# EXTERNAL_OCR_SERVICE_URL=
# EXTERNAL_OCR_AUTH_TOKEN=
# EXTERNAL_OCR_TIMEOUT_SECONDS=60
# OCRMYPDF_BINARY=ocrmypdf
# OCRMYPDF_LANGUAGE=eng
# ENABLE_PDF_OCR_FALLBACK=1
# OCRMYPDF_TIMEOUT_SECONDS=180

# Upload processing worker
# Normal text-PDF uploads are prepared by browser-side selectable-text extraction, then finalized
# through a separate text-save request so the PDF file and extracted text are not sent together.
# Scan-only PDFs are saved as needs_ocr instead of a fake queued/processing state.
# Run `python -m backend.document_worker` only for legacy queued PDFs or optional background processing.
# UPLOAD_PDF_OCR_FALLBACK defaults off so expensive OCR is not part of normal upload or summary requests.
# UPLOAD_PDF_OCR_FALLBACK=0
# DOCUMENT_WORKER_BATCH_SIZE=5
# DOCUMENT_WORKER_POLL_SECONDS=5
# DOCUMENT_PROCESSING_STALE_MINUTES=30

# App behaviour
# TRASH_RETENTION_DAYS=30
# Optional font used when exporting edited content back to PDF.
# Set this to a deployed .ttf font such as NotoSansCJK-Regular.ttf if Chinese or other
# non-Latin text must render exactly in generated PDFs.
# PDF_EXPORT_FONT_PATH=

# Transitional compatibility note:
# The React preview UI uses same-origin HTTP-only cookies and no longer generates
# `/api/documents/:id/file?auth_token=...`; the backend still accepts old links temporarily.
